[Unit]
Description=Sync GTK/libadwaita dconf settings from gtk-3.0/settings.ini
# Runs at user login (default.target), independent of which WM/session starts.
After=dbus.service
Requires=dbus.service

[Service]
Type=oneshot
ExecStart=%h/.local/bin/theme-dconf-sync

[Install]
WantedBy=default.target
